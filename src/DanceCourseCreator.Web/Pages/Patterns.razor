@page "/patterns"
@* @attribute [Authorize] *@
@inject IPatternsService PatternsService
@inject IDialogService DialogService

<PageTitle>Mönster - Kursskapare</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudGrid>
        <MudItem xs="12">
            <MudCard>
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h4">Turbank</MudText>
                        <MudText Typo="Typo.body1" Color="Color.Secondary">Utforska din samling av dansmönster och övningar för olika dansstilar</MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="Icons.Material.Filled.Add"
                                   OnClick="OpenCreateDialog">
                            Lägg till mönster
                        </MudButton>
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    <!-- Filters -->
                    <MudGrid Class="mb-4">
                        <MudItem xs="12" sm="2">
                            <MudSelect @bind-Value="filterType" Label="Typ" Clearable="true" OnClearButtonClick="@(async () => { filterType = null; await LoadPatterns(); })">>
                                <MudSelectItem Value="@("pattern")">Mönster</MudSelectItem>
                                <MudSelectItem Value="@("exercise")">Övning</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="2">
                            <MudSelect @bind-Value="filterLevel" Label="Nivå" Clearable="true" OnClearButtonClick="@(async () => { filterLevel = null; await LoadPatterns(); })">>
                                <MudSelectItem Value="@("beginner")">Nybörjare</MudSelectItem>
                                <MudSelectItem Value="@("improver")">Förbättrare</MudSelectItem>
                                <MudSelectItem Value="@("intermediate")">Medel</MudSelectItem>
                                <MudSelectItem Value="@("advanced")">Avancerad</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="3">
                            <MudSelect @bind-Value="filterDanceStyle" Label="Dansstil" Clearable="true" OnClearButtonClick="@(async () => { filterDanceStyle = null; await LoadPatterns(); })">
                                <MudSelectItem Value="@("WestCoastSwing")">West Coast Swing</MudSelectItem>
                                <MudSelectItem Value="@("Bugg")">Bugg</MudSelectItem>
                                <MudSelectItem Value="@("Fox")">Fox</MudSelectItem>
                                <MudSelectItem Value="@("Foxtrot")">Foxtrot</MudSelectItem>
                                <MudSelectItem Value="@("Lindy")">Lindy Hop</MudSelectItem>
                                <MudSelectItem Value="@("Balboa")">Balboa</MudSelectItem>
                                <MudSelectItem Value="@("Blues")">Blues</MudSelectItem>
                                <MudSelectItem Value="@("Other")">Annan</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="3">
                            <MudTextField @bind-Value="searchText" 
                                          Label="Sök mönster..." 
                                          Adornment="Adornment.End" 
                                          AdornmentIcon="Icons.Material.Filled.Search"
                                          OnAdornmentClick="LoadPatterns" />
                        </MudItem>
                        <MudItem xs="12" sm="2">
                            <MudButton Variant="Variant.Outlined" 
                                       Color="Color.Primary" 
                                       OnClick="@(async () => await LoadPatterns())"
                                       FullWidth="true">
                                Filtrera
                            </MudButton>
                        </MudItem>
                    </MudGrid>

                    <!-- Results Info -->
                    @if (patterns != null)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                            @patterns.Count objekt i turbanken
                        </MudText>
                    }

                    <!-- Loading Indicator -->
                    @if (isLoading)
                    {
                        <MudProgressLinear Indeterminate="true" />
                    }
                    else if (hasError)
                    {
                        <MudAlert Severity="Severity.Error" Class="mb-4">
                            @errorMessage
                            <MudButton Color="Color.Primary" Variant="Variant.Text" OnClick="LoadPatterns">
                                Försök igen
                            </MudButton>
                        </MudAlert>
                    }

                    <!-- Patterns Grid -->
                    @if (!hasError && patterns != null && patterns.Any())
                    {
                        <MudGrid>
                            @foreach (var pattern in patterns)
                            {
                                <MudItem xs="12" sm="6" md="4">
                                    <MudCard Class="mb-4" Style="height: 100%;">
                                        <MudCardContent>
                                            <MudText Typo="Typo.h6" Class="mb-2">@pattern.Name</MudText>
                                            <div style="display: flex; gap: 4px; flex-wrap: wrap; margin-bottom: 12px;">
                                                <MudChip T="string" Size="Size.Small" Color="GetChipColor(pattern.Level)">
                                                    @pattern.Level?.ToUpperInvariant()
                                                </MudChip>
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="GetTypeColor(pattern.Type)">
                                                    @(pattern.Type?.ToUpperInvariant() == "PATTERN" ? "MÖNSTER" : "ÖVNING")
                                                </MudChip>
                                                @if (!string.IsNullOrEmpty(pattern.DanceStyle))
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Info">
                                                        @GetDanceStyleDisplayName(pattern.DanceStyle)
                                                    </MudChip>
                                                }
                                            </div>
                                            <MudText Typo="Typo.body2" Class="mb-3" Style="color: var(--mud-palette-text-secondary);">
                                                @(string.IsNullOrEmpty(pattern.Description) ? "Ingen beskrivning" : 
                                                  pattern.Description.Length > 120 ? pattern.Description.Substring(0, 120) + "..." : pattern.Description)
                                            </MudText>
                                            @if (pattern.EstimatedMinutes > 0)
                                            {
                                                <div style="display: flex; align-items: center; color: var(--mud-palette-text-secondary);">
                                                    <MudIcon Icon="Icons.Material.Filled.Timer" Size="Size.Small" Class="mr-1" /> 
                                                    <MudText Typo="Typo.caption">@pattern.EstimatedMinutes min</MudText>
                                                </div>
                                            }
                                        </MudCardContent>
                                        <MudCardActions>
                                            <MudButton Size="Size.Small" 
                                                       Color="Color.Primary" 
                                                       OnClick="@(() => ViewPattern(pattern))">
                                                Visa
                                            </MudButton>
                                            <MudButton Size="Size.Small" 
                                                       Color="Color.Secondary" 
                                                       OnClick="@(() => EditPattern(pattern))">
                                                Redigera
                                            </MudButton>
                                            <MudIconButton Size="Size.Small"
                                                           Icon="Icons.Material.Filled.Delete"
                                                           Color="Color.Error"
                                                           aria-label="@($"Ta bort {pattern.Name}")"
                                                           OnClick="@(() => DeletePattern(pattern))" />
                                        </MudCardActions>
                                    </MudCard>
                                </MudItem>
                            }
                        </MudGrid>
                    }
                    else if (!isLoading && !hasError)
                    {
                        <MudPaper Class="pa-8 text-center" Style="background-color: var(--mud-palette-grey-lighten5);">
                            <MudIcon Icon="Icons.Material.Filled.LibraryBooks" Size="Size.Large" Color="Color.Secondary" Class="mb-4" />
                            <MudText Typo="Typo.h6" Class="mb-2">Inga mönster hittades</MudText>
                            <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">
                                Börja genom att lägga till ditt första mönster!
                            </MudText>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="Icons.Material.Filled.Add"
                                       OnClick="OpenCreateDialog">
                                Lägg till mönster
                            </MudButton>
                        </MudPaper>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private List<PatternOrExercise>? patterns;
    private bool isLoading = false;
    private bool hasError = false;
    private string? errorMessage;
    private string? filterType;
    private string? filterLevel;
    private string? filterDanceStyle;
    private string searchText = string.Empty;

    [Inject] private ILogger<Patterns> Logger { get; set; } = null!;
    [Inject] private ISnackbar Snackbar { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        await LoadPatterns();
    }

    private async Task LoadPatterns()
    {
        isLoading = true;
        hasError = false;
        errorMessage = null;
        try
        {
            var searchValue = string.IsNullOrWhiteSpace(searchText) ? null : searchText;
            patterns = await PatternsService.GetPatternsAsync(filterType, filterLevel, filterDanceStyle, searchValue);
            if (patterns is null)
            {
                hasError = true;
                errorMessage = "Kunde inte hämta turbanken. Kontrollera anslutningen och försök igen.";
            }
        }
        catch (HttpRequestException ex)
        {
            Logger.LogWarning(ex, "Network error loading patterns: {Message}", ex.Message);
            hasError = true;
            errorMessage = "Kunde inte ansluta till servern. Kontrollera din anslutning och försök igen.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading patterns: {Message}", ex.Message);
            hasError = true;
            errorMessage = "Ett oväntat fel uppstod vid hämtning av mönster.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private Color GetChipColor(string? level)
    {
        return level?.ToLower() switch
        {
            "beginner" => Color.Success,
            "improver" => Color.Info,
            "intermediate" => Color.Warning,
            "advanced" => Color.Error,
            _ => Color.Default
        };
    }

    private Color GetTypeColor(string? type)
    {
        return type?.ToLower() switch
        {
            "pattern" => Color.Primary,
            "exercise" => Color.Secondary,
            _ => Color.Default
        };
    }
    
    private string GetDanceStyleDisplayName(string danceStyle)
    {
        return danceStyle switch
        {
            "WestCoastSwing" => "West Coast Swing",
            "Bugg" => "Bugg",
            "Fox" => "Fox",
            "Foxtrot" => "Foxtrot",
            "Lindy" => "Lindy Hop",
            "Balboa" => "Balboa",
            "Blues" => "Blues",
            "Other" => "Annan",
            _ => danceStyle
        };
    }

    private Task OpenCreateDialog() => OpenPatternDialog();

    private async Task ViewPattern(PatternOrExercise pattern)
    {
        var parameters = new DialogParameters<PatternEditorDialog>
        {
            { dialog => dialog.Pattern, pattern },
            { dialog => dialog.ReadOnly, true }
        };

        await DialogService.ShowAsync<PatternEditorDialog>(
            pattern.Name,
            parameters,
            new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true });
    }

    private async Task EditPattern(PatternOrExercise pattern)
    {
        await OpenPatternDialog(pattern);
    }

    private async Task DeletePattern(PatternOrExercise pattern)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Ta bort från turbanken?",
            $"Vill du ta bort ”{pattern.Name}”? Åtgärden kan inte ångras.",
            yesText: "Ta bort",
            cancelText: "Avbryt");

        if (confirmed != true)
        {
            return;
        }

        try
        {
            if (await PatternsService.DeletePatternAsync(pattern.Id))
            {
                Snackbar.Add("Mönstret har tagits bort.", Severity.Success);
                await LoadPatterns();
            }
            else
            {
                Snackbar.Add("Kunde inte ta bort mönstret. Kontrollera behörighet och försök igen.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not delete pattern {PatternId}", pattern.Id);
            Snackbar.Add("Ett fel uppstod när mönstret skulle tas bort. Försök igen.", Severity.Error);
        }
    }

    private async Task OpenPatternDialog(PatternOrExercise? pattern = null)
    {
        var parameters = new DialogParameters<PatternEditorDialog>
        {
            { dialog => dialog.Pattern, pattern }
        };
        var dialog = await DialogService.ShowAsync<PatternEditorDialog>(
            pattern is null ? "Lägg till i turbanken" : "Redigera i turbanken",
            parameters,
            new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true, BackdropClick = false });

        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadPatterns();
        }
    }
}