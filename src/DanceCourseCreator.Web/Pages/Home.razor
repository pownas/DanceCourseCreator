@page "/"
@* @attribute [Authorize] *@
@inject IPatternsService PatternsService

<PageTitle>Kursskapare - Dance Course Creator</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <!-- Hero section -->
    <div class="hero-section mb-6">
        <MudText Typo="Typo.h3" GutterBottom="true" Class="hero-title">
            <MudIcon Icon="Icons.Material.Filled.MusicNote" Class="mr-2" Color="Color.Primary" />
            Välkommen till WCS Kursskapare
        </MudText>
        <MudText Typo="Typo.h6" Color="Color.Secondary" Class="hero-subtitle">
            Planera, strukturera och dela dina West Coast Swing-lektioner och kurser
        </MudText>
    </div>
    
    <!-- Demo User Info -->
    <AuthorizeView>
        <NotAuthorized>
            <MudAlert Severity="Severity.Info" Class="mb-6" Icon="Icons.Material.Filled.Info">
                <MudText Typo="Typo.body1" Class="mb-2">
                    <strong>Prova tjänsten med demoanvändare:</strong>
                </MudText>
                <MudText Typo="Typo.body2">
                    E-post: <strong>demo@dancecourse.com</strong> | Lösenord: <strong>demo123</strong>
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                    Demoanvändaren har enbart läsrättigheter och kan inte redigera innehåll.
                </MudText>
                <MudButton Variant="Variant.Text" 
                           Color="Color.Primary" 
                           Href="/login"
                           StartIcon="Icons.Material.Filled.Login"
                           Class="mt-2">
                    Logga in
                </MudButton>
            </MudAlert>
        </NotAuthorized>
    </AuthorizeView>
    
    <!-- Library Overview Stats -->
    <MudText Typo="Typo.h5" GutterBottom="true" Class="mb-4 section-header">
        <MudIcon Icon="Icons.Material.Filled.Analytics" Class="mr-2" />
        Biblioteksöversikt
    </MudText>
    <MudGrid Class="mb-6">
        <MudItem xs="6" sm="3">
            <MudPaper Class="pa-4 text-center" Elevation="2">
                <MudText Typo="Typo.h3" Color="Color.Primary">@_totalPatterns</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Tillgängliga mönster</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Class="pa-4 text-center" Elevation="2">
                <MudText Typo="Typo.h3" Color="Color.Success">@_beginnerCount</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Nybörjarnivå</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Class="pa-4 text-center" Elevation="2">
                <MudText Typo="Typo.h3" Color="Color.Info">@_improverCount</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Förbättringsnivå</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Class="pa-4 text-center" Elevation="2">
                <MudText Typo="Typo.h3" Color="Color.Secondary">@_exerciseCount</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Övningar</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>
    
    <!-- Quick Actions -->
    <MudText Typo="Typo.h5" GutterBottom="true" Class="mb-4 section-header">
        <MudIcon Icon="Icons.Material.Filled.FlashOn" Class="mr-2" />
        Snabbåtgärder
    </MudText>
    <MudGrid Class="mb-6">
        <MudItem xs="12" sm="4">
            <MudCard Elevation="3" Class="pa-4" Style="height: 100%;">
                <MudCardContent>
                    <div style="text-align: center; margin-bottom: 16px;">
                        <MudIcon Icon="Icons.Material.Filled.LibraryBooks" Size="Size.Large" Color="Color.Primary" />
                    </div>
                    <MudText Typo="Typo.h6" Align="Align.Center" GutterBottom="true">Bläddra i turbank</MudText>
                    <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                        Utforska tillgängliga West Coast Swing-mönster och övningar
                    </MudText>
                </MudCardContent>
                <MudCardActions Style="justify-content: center;">
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               Href="/patterns"
                               StartIcon="Icons.Material.Filled.ArrowForward">
                        Kom igång
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
        
        <MudItem xs="12" sm="4">
            <MudCard Elevation="3" Class="pa-4" Style="height: 100%; opacity: 0.6;">
                <MudCardContent>
                    <div style="text-align: center; margin-bottom: 16px;">
                        <MudIcon Icon="Icons.Material.Filled.Assignment" Size="Size.Large" Color="Color.Secondary" />
                    </div>
                    <MudText Typo="Typo.h6" Align="Align.Center" GutterBottom="true">
                        Skapa ny lektion
                    </MudText>
                    <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                        Bygg en lektionsplan med mönster och övningar
                    </MudText>
                    <div style="text-align: center; margin-top: 8px;">
                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">Kommer snart</MudChip>
                    </div>
                </MudCardContent>
                <MudCardActions Style="justify-content: center;">
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Secondary" 
                               Disabled="true">
                        Kom igång
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
        
        <MudItem xs="12" sm="4">
            <MudCard Elevation="3" Class="pa-4" Style="height: 100%; opacity: 0.6;">
                <MudCardContent>
                    <div style="text-align: center; margin-bottom: 16px;">
                        <MudIcon Icon="Icons.Material.Filled.School" Size="Size.Large" Color="Color.Tertiary" />
                    </div>
                    <MudText Typo="Typo.h6" Align="Align.Center" GutterBottom="true">
                        Planera kurs
                    </MudText>
                    <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                        Designa en fleraveckors kursplan
                    </MudText>
                    <div style="text-align: center; margin-top: 8px;">
                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">Kommer snart</MudChip>
                    </div>
                </MudCardContent>
                <MudCardActions Style="justify-content: center;">
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Tertiary" 
                               Disabled="true">
                        Kom igång
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>
    
    <!-- Getting Started / MVP Info -->
    <MudPaper Class="pa-6 mb-6" Elevation="2">
        <MudText Typo="Typo.h5" GutterBottom="true" Class="mb-4">
            <MudIcon Icon="Icons.Material.Filled.Info" Class="mr-2" Color="Color.Primary" />
            Kom igång med WCS Kursskapare
        </MudText>
        <MudText Typo="Typo.body1" Class="mb-4">
            Välkommen till din verktyg för att planera West Coast Swing-lektioner och kurser. Här är vad som är tillgängligt just nu:
        </MudText>
        <MudList>
            <MudListItem Icon="Icons.Material.Filled.CheckCircle" IconColor="Color.Success">
                <MudText Typo="Typo.body1"><strong>Turbank:</strong> Bläddra bland @_totalPatterns mönster och övningar för West Coast Swing</MudText>
            </MudListItem>
            <MudListItem Icon="Icons.Material.Filled.CheckCircle" IconColor="Color.Success">
                <MudText Typo="Typo.body1"><strong>Filterering:</strong> Sök och filtrera efter nivå, typ och dansstil</MudText>
            </MudListItem>
            <MudListItem Icon="Icons.Material.Filled.Schedule" IconColor="Color.Warning">
                <MudText Typo="Typo.body1"><strong>Lektionsbyggare:</strong> Skapa strukturerade lektionsplaner (kommer snart)</MudText>
            </MudListItem>
            <MudListItem Icon="Icons.Material.Filled.Schedule" IconColor="Color.Warning">
                <MudText Typo="Typo.body1"><strong>Kursplanering:</strong> Planera fleraveckors kurser (kommer snart)</MudText>
            </MudListItem>
            <MudListItem Icon="Icons.Material.Filled.Schedule" IconColor="Color.Warning">
                <MudText Typo="Typo.body1"><strong>Export:</strong> Exportera till PDF och Markdown (kommer snart)</MudText>
            </MudListItem>
        </MudList>
        <MudDivider Class="my-4" />
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Primary" 
                   Href="/patterns"
                   Size="Size.Large"
                   StartIcon="Icons.Material.Filled.Explore">
            Utforska turbanken
        </MudButton>
    </MudPaper>
</MudContainer>

@code {
    private int _totalPatterns = 0;
    private int _beginnerCount = 0;
    private int _improverCount = 0;
    private int _exerciseCount = 0;
#pragma warning disable CS0414
    private bool _hasError = false;
#pragma warning restore CS0414

    [Inject] private ILogger<Home> Logger { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        await LoadStatistics();
    }

    private async Task LoadStatistics()
    {
        try
        {
            _hasError = false;
            var patterns = await PatternsService.GetPatternsAsync();
            if (patterns != null)
            {
                _totalPatterns = patterns.Count;
                _beginnerCount = patterns.Count(p => p.Level?.ToLower() == "beginner");
                _improverCount = patterns.Count(p => p.Level?.ToLower() == "improver");
                _exerciseCount = patterns.Count(p => p.Type?.ToLower() == "exercise");
            }
            else
            {
                // API returned null, use fallback
                Logger.LogWarning("PatternsService returned null, using fallback values");
                SetFallbackValues();
            }
        }
        catch (HttpRequestException ex)
        {
            Logger.LogWarning(ex, "Network error loading patterns, using fallback values: {Message}", ex.Message);
            SetFallbackValues();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error loading statistics: {Message}", ex.Message);
            SetFallbackValues();
            _hasError = true;
        }
    }

    private void SetFallbackValues()
    {
        _totalPatterns = 6;
        _beginnerCount = 4;
        _improverCount = 1;
        _exerciseCount = 2;
    }
}
