@page "/"
@* @attribute [Authorize] *@
@inject IPatternsService PatternsService

<PageTitle>Kursskapare - Dance Course Creator</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <!-- Hero section -->
    <div class="hero-section mb-6">
        <MudText Typo="Typo.h3" GutterBottom="true" Class="hero-title">
            <MudIcon Icon="Icons.Material.Filled.MusicNote" Class="mr-2" Color="Color.Primary" />
            Välkommen till WCS Kursskapare
        </MudText>
        <MudText Typo="Typo.h6" Color="Color.Secondary" Class="hero-subtitle">
            Planera, strukturera och dela dina West Coast Swing-lektioner och kurser
        </MudText>
    </div>
    
    <!-- Demo User Info -->
    <AuthorizeView>
        <NotAuthorized>
            <MudAlert Severity="Severity.Info" Class="mb-6" Icon="Icons.Material.Filled.Info">
                <MudText Typo="Typo.body1" Class="mb-2">
                    <strong>Prova tjänsten med demoanvändare:</strong>
                </MudText>
                <MudText Typo="Typo.body2">
                    E-post: <strong>demo@dancecourse.com</strong> | Lösenord: <strong>demo123</strong>
                </MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                    Demoanvändaren har enbart läsrättigheter och kan inte redigera innehåll.
                </MudText>
                <MudButton Variant="Variant.Text" 
                           Color="Color.Primary" 
                           Href="/login"
                           StartIcon="Icons.Material.Filled.Login"
                           Class="mt-2">
                    Logga in
                </MudButton>
            </MudAlert>
        </NotAuthorized>
    </AuthorizeView>
    
    <!-- Library Overview Stats -->
    <MudText Typo="Typo.h5" GutterBottom="true" Class="mb-4 section-header">
        <MudIcon Icon="Icons.Material.Filled.Analytics" Class="mr-2" />
        Biblioteksöversikt
    </MudText>
    <MudGrid Class="mb-6">
        <MudItem xs="6" sm="3">
            <MudPaper Class="pa-4 text-center" Elevation="2">
                <MudText Typo="Typo.h3" Color="Color.Primary">@GetStatisticsValue(_totalPatterns)</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Mönster och övningar</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Class="pa-4 text-center" Elevation="2">
                <MudText Typo="Typo.h3" Color="Color.Success">@GetStatisticsValue(_beginnerCount)</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Nybörjarnivå</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Class="pa-4 text-center" Elevation="2">
                <MudText Typo="Typo.h3" Color="Color.Info">@GetStatisticsValue(_improverCount)</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Förbättringsnivå</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Class="pa-4 text-center" Elevation="2">
                <MudText Typo="Typo.h3" Color="Color.Secondary">@GetStatisticsValue(_exerciseCount)</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Övningar</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    @if (_hasError)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-6">
            Biblioteksstatistiken kunde inte hämtas. Försök igen eller öppna turbanken.
            <MudButton Color="Color.Primary" Variant="Variant.Text" OnClick="LoadStatistics">
                Försök igen
            </MudButton>
        </MudAlert>
    }
    
    <MudText Typo="Typo.h5" GutterBottom="true" Class="mb-2 section-header">
        <MudIcon Icon="Icons.Material.Filled.FlashOn" Class="mr-2" />
        Planera kursmaterial
    </MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
        Börja i turbanken, bygg lektioner och samla dem sedan i en kursplan.
    </MudText>
    @if (_isLoadingStatistics)
    {
        <div class="mb-2" role="status">
            <MudText Typo="Typo.caption">Hämtar biblioteksstatistik…</MudText>
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        </div>
    }
    <MudGrid Class="mb-6">
        <MudItem xs="12" sm="4">
            <MudCard Elevation="3" Class="pa-4" Style="height: 100%;">
                <MudCardContent>
                    <div style="text-align: center; margin-bottom: 16px;">
                        <MudIcon Icon="Icons.Material.Filled.LibraryBooks" Size="Size.Large" Color="Color.Primary" />
                    </div>
                    <MudText Typo="Typo.h6" Align="Align.Center" GutterBottom="true">1. Utforska turbanken</MudText>
                    <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                        Hitta mönster och övningar att använda i dina lektioner.
                    </MudText>
                </MudCardContent>
                <MudCardActions Style="justify-content: center;">
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               Href="/patterns"
                               StartIcon="Icons.Material.Filled.ArrowForward">
                        Öppna turbanken
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
        
        <MudItem xs="12" sm="4">
            <MudCard Elevation="3" Class="pa-4" Style="height: 100%;">
                <MudCardContent>
                    <div style="text-align: center; margin-bottom: 16px;">
                        <MudIcon Icon="Icons.Material.Filled.Assignment" Size="Size.Large" Color="Color.Secondary" />
                    </div>
                    <MudText Typo="Typo.h6" Align="Align.Center" GutterBottom="true">
                        2. Planera lektioner
                    </MudText>
                    <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                        Skapa, redigera och exportera lektionsplaner.
                    </MudText>
                </MudCardContent>
                <MudCardActions Style="justify-content: center;">
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Secondary"
                               Href="/lessons"
                               StartIcon="Icons.Material.Filled.ArrowForward">
                        Öppna lektioner
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
        
        <MudItem xs="12" sm="4">
            <MudCard Elevation="3" Class="pa-4" Style="height: 100%;">
                <MudCardContent>
                    <div style="text-align: center; margin-bottom: 16px;">
                        <MudIcon Icon="Icons.Material.Filled.School" Size="Size.Large" Color="Color.Tertiary" />
                    </div>
                    <MudText Typo="Typo.h6" Align="Align.Center" GutterBottom="true">
                        3. Planera kurs
                    </MudText>
                    <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
                        Samla lektionerna i en kursplan med flera tillfällen.
                    </MudText>
                </MudCardContent>
                <MudCardActions Style="justify-content: center;">
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Tertiary" 
                               Href="/courses"
                               StartIcon="Icons.Material.Filled.ArrowForward">
                        Öppna kursplaner
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private int _totalPatterns = 0;
    private int _beginnerCount = 0;
    private int _improverCount = 0;
    private int _exerciseCount = 0;
    private bool _hasError = false;
    private bool _isLoadingStatistics = true;

    [Inject] private ILogger<Home> Logger { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        await LoadStatistics();
    }

    private async Task LoadStatistics()
    {
        _isLoadingStatistics = true;
        try
        {
            _hasError = false;
            var patterns = await PatternsService.GetPatternsAsync();
            if (patterns is null)
            {
                Logger.LogWarning("PatternsService returned null while loading home-page statistics");
                _hasError = true;
                return;
            }

            _totalPatterns = patterns.Count;
            _beginnerCount = patterns.Count(p => p.Level?.ToLower() == "beginner");
            _improverCount = patterns.Count(p => p.Level?.ToLower() == "improver");
            _exerciseCount = patterns.Count(p => p.Type?.ToLower() == "exercise");
        }
        catch (HttpRequestException ex)
        {
            Logger.LogWarning(ex, "Network error loading patterns: {Message}", ex.Message);
            _hasError = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error loading statistics: {Message}", ex.Message);
            _hasError = true;
        }
        finally
        {
            _isLoadingStatistics = false;
        }
    }

    private string GetStatisticsValue(int value) =>
        _isLoadingStatistics ? "…" : _hasError ? "—" : value.ToString();
}
