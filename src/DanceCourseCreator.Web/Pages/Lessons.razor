@page "/lessons"
@using DanceCourseCreator.Web.Models
@* @attribute [Authorize] *@
@inject ILessonsService LessonsService
@inject IPatternsService PatternsService
@inject ITemplatesService TemplatesService
@inject IExportService ExportService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Lektioner - Kursskapare</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudGrid>
        <MudItem xs="12">
            <MudPaper Class="pa-4">
                <div class="d-flex justify-space-between align-center mb-4">
                    <div>
                        <MudText Typo="Typo.h4">Lektioner</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Bygg lektioner av mönster och övningar från turbanken.
                        </MudText>
                    </div>
                    <div class="d-flex gap-2">
                        @if (lessons != null && lessons.Any())
                        {
                            <MudButton Variant="Variant.Outlined" 
                                       Color="Color.Info" 
                                       StartIcon="@Icons.Material.Filled.ViewCompact"
                                       OnClick="OpenCompactView">
                                Visa kompakt
                            </MudButton>
                        }

                        <MudButton Variant="Variant.Filled" 
                                   Color="Color.Primary" 
                                   StartIcon="Icons.Material.Filled.Add"
                                   OnClick="OpenCreateDialog">
                            Skapa lektion
                        </MudButton>
                    </div>
                </div>

                @if (isLoading)
                {
                    <div class="d-flex justify-center mt-8">
                        <div role="status" aria-live="polite" class="d-flex flex-column align-center gap-2 mt-8">
                            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Hämtar lektioner…</MudText>
                        </div>
                    </div>
                }
                else if (hasError)
                {
                    <MudAlert Severity="Severity.Error" Class="mt-4">
                        Kunde inte hämta lektionerna. Kontrollera anslutningen och försök igen.
                        <MudButton Color="Color.Primary" Variant="Variant.Text" OnClick="LoadLessons">
                            Försök igen
                        </MudButton>
                    </MudAlert>
                }
                else if (lessons == null || !lessons.Any())
                {
                    <MudPaper Class="pa-8 mt-4 text-center" Outlined="true">
                        <MudIcon Icon="@Icons.Material.Filled.EventNote" Size="Size.Large" Color="Color.Primary" Class="mb-3" />
                        <MudText Typo="Typo.h6" Class="mb-2">Inga lektioner ännu</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                            Skapa din första lektion och välj sedan mönster och övningar från turbanken.
                        </MudText>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="OpenCreateDialog">
                            Skapa första lektionen
                        </MudButton>
                    </MudPaper>
                }
                else
                {
                    <MudGrid>
                        @foreach (var lesson in lessons)
                        {
                            <MudItem xs="12" sm="6" md="4">
                                <MudCard Class="mb-4">
                                    <MudCardContent>
                                        <div class="d-flex justify-space-between align-start mb-2">
                                            <MudText Typo="Typo.h6">
                                                @if (lesson.Date.HasValue)
                                                {
                                                    @lesson.Date.Value.ToString("yyyy-MM-dd")
                                                }
                                                else
                                                {
                                                    <span>Lektion</span>
                                                }
                                            </MudText>
                                            <MudChip T="string" Size="Size.Small" Color="GetDurationColor(lesson.Duration)">
                                                @lesson.Duration min
                                            </MudChip>
                                        </div>
                                        
                                        @if (lesson.Sections.Any())
                                        {
                                            <MudText Typo="Typo.body2" Class="mb-2">
                                                @lesson.Sections.Count delar, @lesson.TotalEstimatedMinutes min planerat
                                            </MudText>
                                            
                                            <div class="mb-2">
                                                @foreach (var section in lesson.Sections.Take(3))
                                                {
                                                    <MudChip T="string" Size="Size.Small" 
                                                             Color="GetSectionColor(section.Type)" 
                                                             Class="mr-1 mb-1">
                                                        @(GetSectionDisplayName(section.Type)) (@(section.Items.Count))
                                                    </MudChip>
                                                }
                                                @if (lesson.Sections.Count > 3)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Class="mr-1 mb-1">
                                                        +@(lesson.Sections.Count - 3) till
                                                    </MudChip>
                                                }
                                            </div>
                                        }
                                        
                                        @if (!string.IsNullOrEmpty(lesson.Notes))
                                        {
                                            <MudText Typo="Typo.body2" Class="text-truncate">
                                                @lesson.Notes
                                            </MudText>
                                        }
                                        
                                        <MudText Typo="Typo.caption" Class="mt-2">
                                            Uppdaterad: @lesson.UpdatedAt.ToString("yyyy-MM-dd HH:mm")
                                        </MudText>
                                    </MudCardContent>
                                    <MudCardActions>
                                        <MudButton Size="Size.Small"
                                                   Color="Color.Primary"
                                                   Variant="Variant.Filled"
                                                   StartIcon="@Icons.Material.Filled.Edit"
                                                   OnClick="() => EditLesson(lesson)">
                                            Redigera
                                        </MudButton>
                                        <MudSpacer />
                                        <MudMenu Label="Fler åtgärder"
                                                 StartIcon="@Icons.Material.Filled.MoreVert"
                                                 Size="Size.Small"
                                                 Variant="Variant.Text">
                                            <MudMenuItem OnClick="@(() => ViewLesson(lesson))">
                                                <MudIcon Icon="@Icons.Material.Filled.Visibility" Class="mr-2" />
                                                Visa
                                            </MudMenuItem>
                                            <MudMenuItem OnClick="@(() => SaveAsTemplate(lesson))">
                                                <MudIcon Icon="@Icons.Material.Filled.ContentCopy" Class="mr-2" />
                                                Spara som mall
                                            </MudMenuItem>
                                            <MudDivider />
                                            <MudMenuItem OnClick="@(() => ExportLesson(lesson, ExportFormat.PDF))">
                                                <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" Class="mr-2" />
                                                Exportera som PDF
                                            </MudMenuItem>
                                            <MudMenuItem OnClick="@(() => ExportLesson(lesson, ExportFormat.Markdown))">
                                                <MudIcon Icon="@Icons.Material.Filled.Description" Class="mr-2" />
                                                Exportera som Markdown
                                            </MudMenuItem>
                                            <MudDivider />
                                            <MudMenuItem OnClick="@(() => DeleteLesson(lesson))">
                                                <MudIcon Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Class="mr-2" />
                                                Ta bort
                                            </MudMenuItem>
                                        </MudMenu>
                                    </MudCardActions>
                                </MudCard>
                            </MudItem>
                        }
                    </MudGrid>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private List<Lesson>? lessons;
    private bool isLoading = false;
    private bool hasError = false;

    [Inject] private ILogger<Lessons> Logger { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        await LoadLessons();
    }

    private async Task LoadLessons()
    {
        isLoading = true;
        hasError = false;
        try
        {
            lessons = await LessonsService.GetLessonsAsync();
            hasError = lessons is null;
        }
        catch (HttpRequestException ex)
        {
            Logger.LogWarning(ex, "Network error loading lessons: {Message}", ex.Message);
            hasError = true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading lessons: {Message}", ex.Message);
            hasError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private Color GetDurationColor(int duration)
    {
        return duration switch
        {
            <= 60 => Color.Success,
            <= 90 => Color.Primary,
            <= 120 => Color.Warning,
            _ => Color.Error
        };
    }

    private Color GetSectionColor(string sectionType)
    {
        return sectionType.ToLower() switch
        {
            "warmup" => Color.Success,
            "technique" => Color.Info,
            "patterns" => Color.Primary,
            "combination" => Color.Secondary,
            "repetition" => Color.Warning,
            "social" => Color.Tertiary,
            _ => Color.Default
        };
    }

    private static string GetSectionDisplayName(string sectionType) =>
        sectionType.ToLowerInvariant() switch
        {
            "warmup" => "Uppvärmning",
            "technique" => "Teknik",
            "patterns" => "Mönster",
            "combination" => "Kombination",
            "repetition" => "Repetition",
            "social" => "Socialdans",
            _ => sectionType
        };

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters();
        // ExtraLarge needed for drag-and-drop interface: pattern selector on left, sections on right
        var options = new DialogOptions() 
        { 
            MaxWidth = MaxWidth.ExtraLarge, 
            FullWidth = true,
            CloseButton = true,
            BackdropClick = false
        };

        var dialog = await DialogService.ShowAsync<LessonBuilderWithDragDrop>("Skapa ny lektion", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await LoadLessons();
            Snackbar.Add("Lektion skapad!", Severity.Success);
        }
    }

    private async Task ViewLesson(Lesson lesson)
    {
        var parameters = new DialogParameters();
        parameters.Add("LessonId", lesson.Id);
        parameters.Add("ReadOnly", true);

        var options = new DialogOptions() 
        { 
            MaxWidth = MaxWidth.ExtraLarge, 
            FullWidth = true,
            CloseButton = true 
        };

        await DialogService.ShowAsync<LessonBuilderWithDragDrop>("Visa lektion", parameters, options);
    }

    private async Task EditLesson(Lesson lesson)
    {
        var parameters = new DialogParameters();
        parameters.Add("LessonId", lesson.Id);
        parameters.Add("ReadOnly", false);

        var options = new DialogOptions() 
        { 
            MaxWidth = MaxWidth.ExtraLarge, 
            FullWidth = true,
            CloseButton = true,
            BackdropClick = false
        };

        var dialog = await DialogService.ShowAsync<LessonBuilderWithDragDrop>("Redigera lektion", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await LoadLessons();
            Snackbar.Add("Lektion uppdaterad!", Severity.Success);
        }
    }

    private async Task DeleteLesson(Lesson lesson)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Ta bort lektion?",
            "Vill du ta bort lektionen? Åtgärden kan inte ångras.",
            yesText: "Ta bort",
            cancelText: "Avbryt"
        );

        if (confirmed == true)
        {
            var success = await LessonsService.DeleteLessonAsync(lesson.Id);
            if (success)
            {
                await LoadLessons();
                Snackbar.Add("Lektionen har tagits bort.", Severity.Success);
            }
            else
            {
                Snackbar.Add("Kunde inte ta bort lektionen. Försök igen.", Severity.Error);
            }
        }
    }

    private async Task SaveAsTemplate(Lesson lesson)
    {
        var parameters = new DialogParameters
        {
            { "ResourceId", lesson.Id },
            { "ResourceType", "Lesson" }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium };

        var dialog = await DialogService.ShowAsync<SaveAsTemplateDialog>("Spara som mall", parameters, options);
        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            Snackbar.Add("Mall skapad framgångsrikt! Se den på Mallar-sidan.", Severity.Success);
        }
    }

    private async Task OpenCompactView()
    {
        if (lessons == null || !lessons.Any())
        {
            Snackbar.Add("Inga lektioner att visa", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            { "Lesson", lessons.First() },
            { "AllLessons", lessons },
            { "ShowNavigation", true }
        };
        var options = new DialogOptions 
        { 
            CloseButton = true, 
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = true
        };

        await DialogService.ShowAsync<LessonCompactViewDialog>("Kompakt vy", parameters, options);
    }

    private async Task ExportLesson(Lesson lesson, ExportFormat format)
    {
        try
        {
            Snackbar.Add($"Exporterar lektionen som {GetExportFormatName(format)}…", Severity.Info);
            await ExportService.ExportLessonAsync(lesson.Id, format, includePatternDetails: true);
            Snackbar.Add($"Lektionen har exporterats som {GetExportFormatName(format)}.", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error exporting lesson {LessonId} as {Format}", lesson.Id, format);
            Snackbar.Add("Kunde inte exportera lektionen. Försök igen.", Severity.Error);
        }
    }

    private static string GetExportFormatName(ExportFormat format) =>
        format == ExportFormat.PDF ? "PDF" : "Markdown";
}