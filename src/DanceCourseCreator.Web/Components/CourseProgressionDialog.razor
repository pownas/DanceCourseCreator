@using DanceCourseCreator.Web.Models
@using DanceCourseCreator.Web.Services
@using MudBlazor

<MudDialog>
    <DialogContent>
        <MudContainer Style="max-height: 600px; overflow-y: auto;">
            @if (isLoading)
            {
                <div class="d-flex justify-center align-center" style="height: 200px;">
                    <MudProgressCircular Size="Size.Large" Color="Color.Primary" Indeterminate="true" />
                </div>
            }
            else if (coverage != null && progression != null)
            {
                <!-- Progression Score -->
                <MudCard Class="mb-4">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Progressionsbedömning</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <div class="d-flex align-center gap-4">
                            <MudProgressCircular Size="Size.Large" 
                                                 Value="@progression.ProgressionScore" 
                                                 Color="@GetScoreColor(progression.ProgressionScore)"
                                                 Style="width: 80px; height: 80px;">
                                <MudText Typo="Typo.h6">@progression.ProgressionScore.ToString("F0")</MudText>
                            </MudProgressCircular>
                            <div class="flex-grow-1">
                                <MudText Typo="Typo.body1">
                                    <strong>Kursnivå:</strong> @progression.Level
                                </MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">
                                    @coverage.TotalSkillsCovered av 8 grundläggande färdigheter täcks (@coverage.CoveragePercentage.ToString("F0")%)
                                </MudText>
                            </div>
                        </div>
                    </MudCardContent>
                </MudCard>

                <!-- Warnings -->
                @if (progression.Warnings.Any())
                {
                    <MudCard Class="mb-4">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">Varningar och rekommendationer</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudList T="string" Dense="true">
                                @foreach (var warning in progression.Warnings.OrderByDescending(w => GetSeverityOrder(w.Severity)))
                                {
                                    <MudListItem T="string">
                                        <div class="d-flex align-start gap-2">
                                            <MudIcon Icon="@GetWarningIcon(warning.Severity)" 
                                                     Color="@GetWarningColor(warning.Severity)" 
                                                     Size="Size.Small" />
                                            <div class="flex-grow-1">
                                                <MudText Typo="Typo.body2">
                                                    <strong>@warning.Message</strong>
                                                </MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    @warning.Recommendation
                                                </MudText>
                                            </div>
                                        </div>
                                    </MudListItem>
                                    <MudDivider />
                                }
                            </MudList>
                        </MudCardContent>
                    </MudCard>
                }
                else
                {
                    <MudAlert Severity="Severity.Success" Class="mb-4">
                        Inga varningar! Kursen har en bra progression och täckning.
                    </MudAlert>
                }

                <!-- Fundamentals Coverage -->
                <MudCard Class="mb-4">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Täckning av grundläggande färdigheter</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudSimpleTable Dense="true" Hover="true">
                            <thead>
                                <tr>
                                    <th>Färdighet</th>
                                    <th>Status</th>
                                    <th>Veckor</th>
                                    <th>Repetitioner</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var skill in coverage.FundamentalsCoverage.Values.OrderByDescending(s => s.IsCovered).ThenBy(s => s.SkillName))
                                {
                                    <tr>
                                        <td>@skill.SkillName</td>
                                        <td>
                                            @if (skill.IsCovered)
                                            {
                                                <MudChip T="string" Color="Color.Success" Size="Size.Small">Täcks</MudChip>
                                            }
                                            else
                                            {
                                                <MudChip T="string" Color="Color.Default" Size="Size.Small">Täcks ej</MudChip>
                                            }
                                        </td>
                                        <td>
                                            @if (skill.WeeksIntroduced.Any())
                                            {
                                                <MudText Typo="Typo.body2">@string.Join(", ", skill.WeeksIntroduced)</MudText>
                                            }
                                            else
                                            {
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">-</MudText>
                                            }
                                        </td>
                                        <td>@skill.RepetitionCount</td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </MudCardContent>
                </MudCard>

                <!-- Weekly Progress -->
                <MudCard>
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Veckovis progression</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        @if (coverage.WeeklyProgress.Any())
                        {
                            <MudTimeline TimelineOrientation="TimelineOrientation.Vertical" TimelinePosition="TimelinePosition.Start">
                                @foreach (var week in coverage.WeeklyProgress)
                                {
                                    <MudTimelineItem Color="Color.Primary" Size="Size.Small">
                                        <ItemOpposite>
                                            <MudText Color="Color.Secondary" Typo="Typo.body2">Vecka @week.WeekNumber</MudText>
                                        </ItemOpposite>
                                        <ItemContent>
                                            <MudCard Outlined="true">
                                                <MudCardContent Class="py-2">
                                                    @if (!string.IsNullOrEmpty(week.Theme))
                                                    {
                                                        <MudText Typo="Typo.body2">
                                                            <strong>Tema:</strong> @week.Theme
                                                        </MudText>
                                                    }
                                                    @if (week.CoveredConcepts.Any())
                                                    {
                                                        <MudText Typo="Typo.body2">
                                                            <strong>Koncept:</strong> @string.Join(", ", week.CoveredConcepts)
                                                        </MudText>
                                                    }
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                        @week.TotalMinutes minuter
                                                    </MudText>
                                                </MudCardContent>
                                            </MudCard>
                                        </ItemContent>
                                    </MudTimelineItem>
                                }
                            </MudTimeline>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info">
                                Inga lektioner har lagts till i kursen ännu.
                            </MudAlert>
                        }
                    </MudCardContent>
                </MudCard>
            }
            else if (errorMessage != null)
            {
                <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
            }
        </MudContainer>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Stäng</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] 
    private MudBlazor.IDialogReference MudDialog { get; set; } = null!;

    [Parameter] 
    public string CourseId { get; set; } = string.Empty;

    [Inject] 
    private ICoursesService CoursesService { get; set; } = null!;

    private CourseCoverageMetrics? coverage;
    private ProgressionAnalysis? progression;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Kunde inte ladda progressionsdata: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadDataAsync()
    {
        coverage = await CoursesService.GetCourseCoverageAsync(CourseId);
        progression = await CoursesService.GetCourseProgressionAsync(CourseId);

        if (coverage == null || progression == null)
        {
            errorMessage = "Kunde inte ladda progressionsdata för kursen.";
        }
    }

    private void Close() => MudDialog.Close();

    private Color GetScoreColor(double score)
    {
        if (score >= 80) return Color.Success;
        if (score >= 60) return Color.Info;
        if (score >= 40) return Color.Warning;
        return Color.Error;
    }

    private Color GetWarningColor(string severity)
    {
        return severity.ToLower() switch
        {
            "high" => Color.Error,
            "medium" => Color.Warning,
            "low" => Color.Info,
            _ => Color.Default
        };
    }

    private string GetWarningIcon(string severity)
    {
        return severity.ToLower() switch
        {
            "high" => Icons.Material.Filled.Error,
            "medium" => Icons.Material.Filled.Warning,
            "low" => Icons.Material.Filled.Info,
            _ => Icons.Material.Filled.Info
        };
    }

    private int GetSeverityOrder(string severity)
    {
        return severity.ToLower() switch
        {
            "high" => 3,
            "medium" => 2,
            "low" => 1,
            _ => 0
        };
    }
}
