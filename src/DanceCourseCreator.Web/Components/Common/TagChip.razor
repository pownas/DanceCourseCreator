@* TagChip.razor - Component for displaying tags as compact chips *@

<MudChip T="string"
         Size="Size.Small"
         Variant="Variant.Text"
         Color="Color.Default"
         Class="tag-chip"
         aria-label="@($"Tagg: {Tag}")">
    @Tag
</MudChip>

@code {
    /// <summary>
    /// The tag text to display
    /// </summary>
    [Parameter]
    public string Tag { get; set; } = string.Empty;
}
