    // Auto-save methods
    
    private void TriggerAutoSave()
    {
        // Mark that there are unsaved changes (will be saved on next timer tick)
        _hasUnsavedChanges = true;
    }

    private async Task AutoSaveToLocalStorage()
    {
        // Only auto-save for new lessons, not when editing existing ones
        // (editing an existing lesson should not overwrite localStorage drafts)
        if (!_hasUnsavedChanges || IsEditMode) return;
        
        try
        {
            var draftData = new LessonBuilderDraft
            {
                LessonRequest = _lessonRequest,
                SelectedLevel = _selectedLevel,
                SavedAt = DateTime.Now
            };
            
            var json = JsonSerializer.Serialize(draftData);
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", LOCAL_STORAGE_KEY, json);
            
            _lastAutoSaveTime = DateTime.Now;
            _hasUnsavedChanges = false;
            
            Logger.LogDebug("Auto-saved lesson draft to localStorage at {Time}", _lastAutoSaveTime);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to auto-save to localStorage: {Message}", ex.Message);
        }
    }

    private async Task<bool> TryLoadFromLocalStorage()
    {
        try
        {
            var json = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", LOCAL_STORAGE_KEY);
            
            if (string.IsNullOrEmpty(json)) return false;
            
            LessonBuilderDraft? draftData;
            try
            {
                draftData = JsonSerializer.Deserialize<LessonBuilderDraft>(json);
            }
            catch (JsonException jsonEx)
            {
                // Malformed JSON data in localStorage - clear it and start fresh
                Logger.LogWarning(jsonEx, "Invalid JSON in localStorage draft, clearing: {Message}", jsonEx.Message);
                await ClearLocalStorage();
                return false;
            }
            
            if (draftData?.LessonRequest == null) return false;
            
            // Ask user if they want to restore the draft
            var confirmed = await DialogService.ShowMessageBox(
                "Återställ utkast",
                $"Ett sparat utkast hittades från {draftData.SavedAt:g}. Vill du återställa det?",
                yesText: "Ja, återställ",
                cancelText: "Nej, börja om");
            
            if (confirmed == true)
            {
                _lessonRequest = draftData.LessonRequest;
                _selectedLevel = draftData.SelectedLevel ?? "beginner";
                _lastAutoSaveTime = draftData.SavedAt;
                
                Snackbar.Add("Utkast återställt!", Severity.Info);
                Logger.LogInformation("Restored lesson draft from localStorage");
                return true;
            }
            else
            {
                // User chose to start fresh, clear the old draft
                await ClearLocalStorage();
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load draft from localStorage: {Message}", ex.Message);
        }
        
        return false;
    }

    private async Task ClearLocalStorage()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.removeItem", LOCAL_STORAGE_KEY);
            _lastAutoSaveTime = null;
            Logger.LogDebug("Cleared lesson draft from localStorage");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to clear localStorage: {Message}", ex.Message);
        }
    }

    // Draft data model for localStorage
    private class LessonBuilderDraft
    {
        public CreateLessonRequest? LessonRequest { get; set; }
        public string? SelectedLevel { get; set; }
        public DateTime SavedAt { get; set; }
    }

    public async ValueTask DisposeAsync()
    {
        // Stop and dispose the auto-save timer
        if (_autoSaveTimer != null)
        {
            _autoSaveTimer.Stop();
            _autoSaveTimer.Dispose();
        }
        
        // Save any pending changes before disposing
        if (_hasUnsavedChanges && !IsEditMode)
        {
            await AutoSaveToLocalStorage();
        }
        
        await BreakpointService.Unsubscribe(_breakpointSubscriptionId);
    }
}
