@using MudBlazor
@inject ILessonsService LessonsService
@inject IPatternsService PatternsService
@inject ITimeValidationService TimeValidationService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialog>
    <DialogContent>
        @if (isLoading)
        {
            <div class="d-flex justify-center pa-8">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else
        {
            <MudContainer Style="max-height: 85vh; overflow-y: auto;">
                <MudGrid>
                    <!-- Lesson Details -->
                    <MudItem xs="12">
                        <MudPaper Class="pa-4 mb-4" Elevation="3">
                            <MudText Typo="Typo.h6" Class="mb-4">
                                <MudIcon Icon="Icons.Material.Filled.EventNote" Class="mr-2" />
                                Lektionsdetaljer
                            </MudText>
                            <MudGrid>
                                <MudItem xs="12" md="6">
                                    <MudDatePicker Label="Datum (valfritt)" 
                                                   @bind-Date="lessonRequest.Date"
                                                   ReadOnly="ReadOnly" />
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudSelect @bind-Value="lessonRequest.Duration" 
                                               Label="Lektionslängd (minuter)"
                                               ReadOnly="ReadOnly">
                                        <MudSelectItem Value="60">60 min (1 timme)</MudSelectItem>
                                        <MudSelectItem Value="75">75 min (1,25 timme)</MudSelectItem>
                                        <MudSelectItem Value="90">90 min (1,5 timme)</MudSelectItem>
                                        <MudSelectItem Value="120">120 min (2 timmar)</MudSelectItem>
                                        <MudSelectItem Value="150">150 min (2,5 timmar)</MudSelectItem>
                                        <MudSelectItem Value="180">180 min (3 timmar)</MudSelectItem>
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12">
                                    <MudTextField @bind-Value="lessonRequest.Notes" 
                                                  Label="Anteckningar" 
                                                  Lines="3"
                                                  ReadOnly="ReadOnly" />
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    </MudItem>

                    <!-- Drag and Drop Builder -->
                    <MudItem xs="12">
                        <MudPaper Class="pa-4" Elevation="3">
                            <div class="d-flex justify-space-between align-center mb-4">
                                <MudText Typo="Typo.h6">
                                    <MudIcon Icon="Icons.Material.Filled.DragIndicator" Class="mr-2" />
                                    Lektionsbyggare med Drag & Drop
                                </MudText>
                                @if (!ReadOnly)
                                {
                                    <div class="d-flex gap-2">
                                        <MudButton Size="Size.Small" 
                                                   Color="Color.Secondary" 
                                                   StartIcon="Icons.Material.Filled.Lightbulb"
                                                   OnClick="ShowQuickTips">
                                            Snabbtips
                                        </MudButton>
                                        <MudButton Size="Size.Small" 
                                                   Color="Color.Primary" 
                                                   StartIcon="Icons.Material.Filled.Add"
                                                   OnClick="AddSection">
                                            Lägg till sektion
                                        </MudButton>
                                    </div>
                                }
                            </div>

                            <!-- Time Summary with Visual Indicator -->
                            <MudAlert Severity="GetTimeSeverity()" Class="mb-4" Variant="Variant.Filled">
                                <div class="d-flex justify-space-between align-center">
                                    <div>
                                        <MudText Typo="Typo.body1">
                                            <strong>Total beräknad tid:</strong> @totalEstimatedTime min av @lessonRequest.Duration min planerad
                                        </MudText>
                                        <MudProgressLinear Value="@GetTimePercentage()" 
                                                          Color="@GetTimeProgressColor()" 
                                                          Size="Size.Medium" 
                                                          Class="mt-2" />
                                    </div>
                                    <MudChip T="string" Color="@GetTimeChipColor()" Size="Size.Medium">
                                        @GetTimeStatus()
                                    </MudChip>
                                </div>
                            </MudAlert>

                            <!-- Info Box for Mobile Users -->
                            <MudAlert Severity="Severity.Info" Class="mb-4 d-md-none">
                                <MudText Typo="Typo.body2">
                                    <strong>Mobilt läge:</strong> Använd knapparna för att lägga till moment. Dra och släpp fungerar bäst på större skärmar.
                                </MudText>
                            </MudAlert>

                            <!-- Pattern/Exercise Selection Drawer -->
                            @if (!ReadOnly && showPatternSelector)
                            {
                                <MudPaper Class="pa-4 mb-4" Elevation="2" Style="border: 2px dashed var(--mud-palette-primary);">
                                    <div class="d-flex justify-space-between align-center mb-3">
                                        <MudText Typo="Typo.subtitle1">
                                            <MudIcon Icon="Icons.Material.Filled.LibraryBooks" Class="mr-2" />
                                            Välj moment från turbanken
                                        </MudText>
                                        <MudIconButton Icon="Icons.Material.Filled.Close" 
                                                      Size="Size.Small"
                                                      OnClick="@(() => showPatternSelector = false)" />
                                    </div>
                                    
                                    <!-- Quick Filters -->
                                    <MudGrid Class="mb-3">
                                        <MudItem xs="12" sm="4">
                                            <MudSelect @bind-Value="filterLevel" 
                                                      Label="Filtrera nivå" 
                                                      Clearable="true"
                                                      T="string">
                                                <MudSelectItem Value="@("beginner")">Nybörjare</MudSelectItem>
                                                <MudSelectItem Value="@("improver")">Förbättrare</MudSelectItem>
                                                <MudSelectItem Value="@("intermediate")">Medel</MudSelectItem>
                                                <MudSelectItem Value="@("advanced")">Avancerad</MudSelectItem>
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="12" sm="4">
                                            <MudSelect @bind-Value="filterType" 
                                                      Label="Filtrera typ"
                                                      Clearable="true"
                                                      T="string">
                                                <MudSelectItem Value="@("pattern")">Turer</MudSelectItem>
                                                <MudSelectItem Value="@("exercise")">Övningar</MudSelectItem>
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="12" sm="4">
                                            <MudTextField @bind-Value="searchPattern" 
                                                         Label="Sök..." 
                                                         Adornment="Adornment.End" 
                                                         AdornmentIcon="Icons.Material.Filled.Search" />
                                        </MudItem>
                                    </MudGrid>

                                    <!-- Available Patterns as Cards -->
                                    <div style="max-height: 400px; overflow-y: auto;">
                                        <MudGrid>
                                            @foreach (var pattern in GetFilteredPatterns())
                                            {
                                                <MudItem xs="12" sm="6" md="4">
                                                    <MudCard Class="pattern-card" Style="cursor: pointer;" @onclick="@(() => QuickAddPattern(pattern.Id))">
                                                        <MudCardContent Class="pa-3">
                                                            <div class="d-flex justify-space-between align-center mb-2">
                                                                <MudText Typo="Typo.subtitle2">@pattern.Name</MudText>
                                                                <MudIconButton Icon="Icons.Material.Filled.Add" 
                                                                              Size="Size.Small" 
                                                                              Color="Color.Primary"
                                                                              OnClick="@(() => QuickAddPattern(pattern.Id))" />
                                                            </div>
                                                            <div class="d-flex gap-1 mb-2">
                                                                <MudChip T="string" Size="Size.Small" Color="GetLevelColor(pattern.Level)">
                                                                    @GetLevelDisplayName(pattern.Level)
                                                                </MudChip>
                                                                <MudChip T="string" Size="Size.Small" Color="GetTypeColor(pattern.Type)">
                                                                    @GetTypeDisplayName(pattern.Type)
                                                                </MudChip>
                                                            </div>
                                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                                <MudIcon Icon="Icons.Material.Filled.Timer" Size="Size.Small" /> @pattern.EstimatedMinutes min
                                                            </MudText>
                                                        </MudCardContent>
                                                    </MudCard>
                                                </MudItem>
                                            }
                                        </MudGrid>
                                    </div>
                                </MudPaper>
                            }

                            <!-- Lesson Sections with Drag & Drop -->
                            @if (lessonRequest.Sections.Any())
                            {
                                <MudDropContainer T="DropItem" 
                                                 Items="@dropItems" 
                                                 ItemsSelector="@((item, dropzone) => item.SectionIndex.ToString() == dropzone)"
                                                 ItemDropped="OnItemDropped"
                                                 Class="d-flex flex-column gap-3">
                                    <ChildContent>
                                        @for (int i = 0; i < lessonRequest.Sections.Count; i++)
                                        {
                                            var section = lessonRequest.Sections[i];
                                            var sectionIndex = i;
                                            
                                            <MudPaper Class="pa-4 section-paper" Elevation="4">
                                                <!-- Section Header -->
                                                <div class="d-flex justify-space-between align-center mb-3">
                                                    <div class="d-flex align-center gap-3 flex-grow-1">
                                                        <MudIcon Icon="@GetSectionIcon(section.Type)" />
                                                        <MudSelect @bind-Value="section.Type" 
                                                                   Label="Sektionstyp"
                                                                   ReadOnly="ReadOnly"
                                                                   Style="min-width: 180px;">
                                                            <MudSelectItem Value="@("Warmup")">Uppvärmning</MudSelectItem>
                                                            <MudSelectItem Value="@("Technique")">Teknik</MudSelectItem>
                                                            <MudSelectItem Value="@("Patterns")">Turer</MudSelectItem>
                                                            <MudSelectItem Value="@("Combination")">Kombination</MudSelectItem>
                                                            <MudSelectItem Value="@("Repetition")">Repetition</MudSelectItem>
                                                            <MudSelectItem Value="@("Social")">Socialdans</MudSelectItem>
                                                        </MudSelect>
                                                        
                                                        <MudNumericField @bind-Value="section.AllocatedMinutes" 
                                                                        Label="Allokerad tid"
                                                                        Min="0"
                                                                        Max="120"
                                                                        ReadOnly="ReadOnly"
                                                                        Style="min-width: 130px;"
                                                                        Adornment="Adornment.End"
                                                                        AdornmentText="min"
                                                                        OnBlur="RecalculateTime" />
                                                        
                                                        <MudChip T="string" Size="Size.Small" Color="@GetSectionTimeColor(section)">
                                                            Uppskattad: @TimeValidationService.CalculateSectionEstimatedTime(section, patterns) min
                                                        </MudChip>
                                                    </div>
                                                    
                                                    @if (!ReadOnly)
                                                    {
                                                        <div class="d-flex align-center">
                                                            @if (sectionIndex > 0)
                                                            {
                                                                <MudIconButton Icon="Icons.Material.Filled.KeyboardArrowUp" 
                                                                              Size="Size.Small"
                                                                              OnClick="() => MoveSectionUp(sectionIndex)"
                                                                              Title="Flytta upp" />
                                                            }
                                                            @if (sectionIndex < lessonRequest.Sections.Count - 1)
                                                            {
                                                                <MudIconButton Icon="Icons.Material.Filled.KeyboardArrowDown" 
                                                                              Size="Size.Small"
                                                                              OnClick="() => MoveSectionDown(sectionIndex)"
                                                                              Title="Flytta ner" />
                                                            }
                                                            <MudIconButton Icon="Icons.Material.Filled.Delete" 
                                                                          Size="Size.Small"
                                                                          Color="Color.Error"
                                                                          OnClick="() => RemoveSection(sectionIndex)"
                                                                          Title="Ta bort sektion" />
                                                        </div>
                                                    }
                                                </div>

                                                <!-- Drop Zone for Patterns -->
                                                <MudDropZone T="DropItem" 
                                                            Identifier="@sectionIndex.ToString()" 
                                                            Class="drop-zone rounded-lg pa-3 mb-3"
                                                            AllowReorder="true">
                                                    @if (!section.Items.Any())
                                                    {
                                                        <div class="drop-zone-empty">
                                                            <MudIcon Icon="Icons.Material.Filled.TouchApp" Size="Size.Large" Color="Color.Secondary" />
                                                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
                                                                Dra moment hit eller använd knappen nedan
                                                            </MudText>
                                                        </div>
                                                    }
                                                </MudDropZone>

                                                <!-- Add Button for Mobile -->
                                                @if (!ReadOnly)
                                                {
                                                    <MudButton Size="Size.Small" 
                                                              Color="Color.Secondary" 
                                                              StartIcon="Icons.Material.Filled.Add"
                                                              OnClick="@(() => { currentSectionIndex = sectionIndex; showPatternSelector = true; })"
                                                              FullWidth="false"
                                                              Class="mb-3">
                                                        Lägg till moment
                                                    </MudButton>
                                                }

                                                <!-- Section Notes -->
                                                <MudTextField @bind-Value="section.Notes" 
                                                             Label="Anteckningar för sektionen" 
                                                             Lines="2"
                                                             ReadOnly="ReadOnly"
                                                             Class="mt-2" />
                                            </MudPaper>
                                        }
                                    </ChildContent>
                                    <ItemRenderer>
                                        <MudPaper Class="pa-3 mb-2 pattern-item-draggable" Elevation="2">
                                            <div class="d-flex justify-space-between align-center">
                                                <div class="flex-grow-1">
                                                    @{
                                                        var pattern = patterns?.FirstOrDefault(p => p.Id == context.PatternId);
                                                        if (pattern != null)
                                                        {
                                                            <div class="d-flex align-center gap-2">
                                                                <MudIcon Icon="Icons.Material.Filled.DragIndicator" Size="Size.Small" Color="Color.Secondary" />
                                                                <div>
                                                                    <MudText Typo="Typo.body1"><strong>@pattern.Name</strong></MudText>
                                                                    <div class="d-flex gap-1 mt-1">
                                                                        <MudChip T="string" Size="Size.Small" Color="GetTypeColor(pattern.Type)">
                                                                            @GetTypeDisplayName(pattern.Type)
                                                                        </MudChip>
                                                                        <MudChip T="string" Size="Size.Small" Color="GetLevelColor(pattern.Level)">
                                                                            @GetLevelDisplayName(pattern.Level)
                                                                        </MudChip>
                                                                        <MudChip T="string" Size="Size.Small">
                                                                            <MudIcon Icon="Icons.Material.Filled.Timer" Size="Size.Small" /> @pattern.EstimatedMinutes min
                                                                        </MudChip>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <MudText Typo="Typo.body1" Class="text-muted">@context.PatternId</MudText>
                                                        }
                                                    }
                                                </div>
                                                
                                                @if (!ReadOnly)
                                                {
                                                    <MudIconButton Icon="Icons.Material.Filled.Delete" 
                                                                  Size="Size.Small"
                                                                  Color="Color.Error"
                                                                  OnClick="@(() => RemoveItemFromSection(context.SectionIndex, context.ItemIndex))"
                                                                  Title="Ta bort" />
                                                }
                                            </div>
                                        </MudPaper>
                                    </ItemRenderer>
                                </MudDropContainer>
                            }
                            else
                            {
                                <MudAlert Severity="Severity.Info" Class="mt-4">
                                    <MudText Typo="Typo.body1">
                                        Inga sektioner ännu. Klicka på "Lägg till sektion" för att börja bygga din lektion!
                                    </MudText>
                                </MudAlert>
                            }
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudContainer>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Avbryt</MudButton>
        @if (!ReadOnly)
        {
            <MudButton Color="Color.Primary" 
                      Variant="Variant.Filled" 
                      OnClick="Save"
                      Disabled="isSaving">
                @if (isSaving)
                {
                    <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                }
                @(LessonId != null ? "Uppdatera" : "Skapa")
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudBlazor.IDialogReference MudDialog { get; set; } = null!;
    
    [Parameter] public string? LessonId { get; set; }
    [Parameter] public bool ReadOnly { get; set; }

    private CreateLessonRequest lessonRequest = new();
    private List<PatternOrExercise>? patterns;
    private List<DropItem> dropItems = new();
    private bool isLoading = true;
    private bool isSaving = false;
    private bool showPatternSelector = false;
    private int currentSectionIndex = -1;
    private int totalEstimatedTime = 0;
    
    // Filters
    private string? filterLevel;
    private string? filterType;
    private string searchPattern = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            // Load all patterns
            patterns = await PatternsService.GetPatternsAsync();
            
            // If editing, load the lesson
            if (LessonId != null)
            {
                var lesson = await LessonsService.GetLessonAsync(LessonId);
                if (lesson != null)
                {
                    lessonRequest = new CreateLessonRequest
                    {
                        CourseId = lesson.CourseId,
                        Date = lesson.Date,
                        Duration = lesson.Duration,
                        Sections = lesson.Sections,
                        Notes = lesson.Notes
                    };
                }
            }
            else
            {
                // Initialize with a default section for new lessons
                lessonRequest.Sections.Add(new LessonSection 
                { 
                    Id = Guid.NewGuid().ToString(),
                    Type = "Warmup",
                    AllocatedMinutes = 10
                });
            }
            
            RebuildDropItems();
            RecalculateTime();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fel vid laddning: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void RebuildDropItems()
    {
        dropItems.Clear();
        for (int i = 0; i < lessonRequest.Sections.Count; i++)
        {
            var section = lessonRequest.Sections[i];
            for (int j = 0; j < section.Items.Count; j++)
            {
                dropItems.Add(new DropItem
                {
                    PatternId = section.Items[j],
                    SectionIndex = i,
                    ItemIndex = j
                });
            }
        }
    }

    private void RecalculateTime()
    {
        totalEstimatedTime = 0;
        foreach (var section in lessonRequest.Sections)
        {
            totalEstimatedTime += TimeValidationService.CalculateSectionEstimatedTime(section, patterns);
        }
        StateHasChanged();
    }

    private void AddSection()
    {
        lessonRequest.Sections.Add(new LessonSection
        {
            Id = Guid.NewGuid().ToString(),
            Type = "Patterns",
            AllocatedMinutes = 15
        });
        RebuildDropItems();
    }

    private void RemoveSection(int index)
    {
        lessonRequest.Sections.RemoveAt(index);
        RebuildDropItems();
        RecalculateTime();
    }

    private void MoveSectionUp(int index)
    {
        if (index > 0)
        {
            var section = lessonRequest.Sections[index];
            lessonRequest.Sections.RemoveAt(index);
            lessonRequest.Sections.Insert(index - 1, section);
            RebuildDropItems();
        }
    }

    private void MoveSectionDown(int index)
    {
        if (index < lessonRequest.Sections.Count - 1)
        {
            var section = lessonRequest.Sections[index];
            lessonRequest.Sections.RemoveAt(index);
            lessonRequest.Sections.Insert(index + 1, section);
            RebuildDropItems();
        }
    }

    private void OnItemDropped(MudItemDropInfo<DropItem> dropInfo)
    {
        if (dropInfo.Item == null) return;
        
        var item = dropInfo.Item;
        int newSectionIndex = int.Parse(dropInfo.DropzoneIdentifier);
        
        // Remove from old section
        lessonRequest.Sections[item.SectionIndex].Items.RemoveAt(item.ItemIndex);
        
        // Add to new section
        lessonRequest.Sections[newSectionIndex].Items.Insert(dropInfo.IndexInZone, item.PatternId);
        
        // Rebuild
        RebuildDropItems();
        RecalculateTime();
    }

    private void QuickAddPattern(string patternId)
    {
        if (currentSectionIndex >= 0 && currentSectionIndex < lessonRequest.Sections.Count)
        {
            lessonRequest.Sections[currentSectionIndex].Items.Add(patternId);
            RebuildDropItems();
            RecalculateTime();
            Snackbar.Add("Moment tillagt!", Severity.Success);
        }
        else
        {
            Snackbar.Add("Välj en sektion först", Severity.Warning);
        }
    }

    private void RemoveItemFromSection(int sectionIndex, int itemIndex)
    {
        var section = lessonRequest.Sections[sectionIndex];
        if (itemIndex >= 0 && itemIndex < section.Items.Count)
        {
            section.Items.RemoveAt(itemIndex);
            RebuildDropItems();
            RecalculateTime();
        }
    }

    private List<PatternOrExercise> GetFilteredPatterns()
    {
        if (patterns == null) return new List<PatternOrExercise>();
        
        var filtered = patterns.AsEnumerable();
        
        if (!string.IsNullOrWhiteSpace(filterLevel))
        {
            filtered = filtered.Where(p => p.Level.Equals(filterLevel, StringComparison.OrdinalIgnoreCase));
        }
        
        if (!string.IsNullOrWhiteSpace(filterType))
        {
            filtered = filtered.Where(p => p.Type.Equals(filterType, StringComparison.OrdinalIgnoreCase));
        }
        
        if (!string.IsNullOrWhiteSpace(searchPattern))
        {
            filtered = filtered.Where(p => 
                p.Name.Contains(searchPattern, StringComparison.OrdinalIgnoreCase) ||
                p.Description.Contains(searchPattern, StringComparison.OrdinalIgnoreCase));
        }
        
        // Limit results for performance, but allow more if filtered
        var limit = string.IsNullOrWhiteSpace(filterLevel) && string.IsNullOrWhiteSpace(filterType) 
            && string.IsNullOrWhiteSpace(searchPattern) ? 20 : 50;
        return filtered.Take(limit).ToList();
    }

    private async Task ShowQuickTips()
    {
        await DialogService.ShowMessageBox(
            "Snabbtips för lektionsbyggaren",
            @"• Dra moment från turbanken till sektioner (fungerar bäst på desktop)
• Använd 'Lägg till moment' för mobila enheter
• Varje sektion visar uppskattad tid baserat på valda moment
• Färgkodning hjälper dig se om tiden är lagom, för lång eller för kort
• Flytta sektioner upp/ner för att ändra ordning
• Ta bort sektioner eller moment med papperskorgsikonen",
            cancelText: "Stäng");
    }

    private Severity GetTimeSeverity()
    {
        double percentage = GetTimePercentage();
        if (percentage > 110) return Severity.Error;
        if (percentage > 100) return Severity.Warning;
        if (percentage < 80) return Severity.Info;
        return Severity.Success;
    }

    private Color GetTimeProgressColor()
    {
        double percentage = GetTimePercentage();
        if (percentage > 110) return Color.Error;
        if (percentage > 100) return Color.Warning;
        if (percentage < 80) return Color.Info;
        return Color.Success;
    }

    private Color GetTimeChipColor()
    {
        double percentage = GetTimePercentage();
        if (percentage > 110) return Color.Error;
        if (percentage > 100) return Color.Warning;
        if (percentage < 80) return Color.Info;
        return Color.Success;
    }

    private string GetTimeStatus()
    {
        double percentage = GetTimePercentage();
        if (percentage > 110) return "För lång!";
        if (percentage > 100) return "Lite för lång";
        if (percentage < 80) return "Mer tid finns";
        return "Perfekt tid!";
    }

    private double GetTimePercentage()
    {
        if (lessonRequest.Duration == 0) return 0;
        return (double)totalEstimatedTime / lessonRequest.Duration * 100;
    }

    private Color GetSectionTimeColor(LessonSection section)
    {
        int estimated = TimeValidationService.CalculateSectionEstimatedTime(section, patterns);
        int allocated = section.AllocatedMinutes;
        
        if (allocated == 0) return Color.Default;
        
        double percentage = (double)estimated / allocated * 100;
        if (percentage > 120) return Color.Error;
        if (percentage > 100) return Color.Warning;
        if (percentage < 80) return Color.Info;
        return Color.Success;
    }

    private string GetSectionIcon(string sectionType)
    {
        return sectionType switch
        {
            "Warmup" => Icons.Material.Filled.FitnessCenter,
            "Technique" => Icons.Material.Filled.Settings,
            "Patterns" => Icons.Material.Filled.Psychology,
            "Combination" => Icons.Material.Filled.Shuffle,
            "Repetition" => Icons.Material.Filled.Replay,
            "Social" => Icons.Material.Filled.Groups,
            _ => Icons.Material.Filled.Circle
        };
    }

    private Color GetLevelColor(string level)
    {
        return level.ToLower() switch
        {
            "beginner" => Color.Success,
            "improver" => Color.Info,
            "intermediate" => Color.Warning,
            "advanced" => Color.Error,
            _ => Color.Default
        };
    }

    private string GetLevelDisplayName(string level)
    {
        return level.ToLower() switch
        {
            "beginner" => "Nybörjare",
            "improver" => "Förbättrare",
            "intermediate" => "Medel",
            "advanced" => "Avancerad",
            _ => level
        };
    }

    private Color GetTypeColor(string type)
    {
        return type.ToLower() switch
        {
            "pattern" => Color.Primary,
            "exercise" => Color.Secondary,
            _ => Color.Default
        };
    }

    private string GetTypeDisplayName(string type)
    {
        return type.ToLower() switch
        {
            "pattern" => "Tur",
            "exercise" => "Övning",
            _ => type
        };
    }

    private async Task Save()
    {
        isSaving = true;
        try
        {
            if (LessonId != null)
            {
                // Update existing lesson
                var existingLesson = await LessonsService.GetLessonAsync(LessonId);
                if (existingLesson != null)
                {
                    // Create update request
                    var updateRequest = new CreateLessonRequest
                    {
                        CourseId = lessonRequest.CourseId,
                        Date = lessonRequest.Date,
                        Duration = lessonRequest.Duration,
                        Sections = lessonRequest.Sections,
                        Notes = lessonRequest.Notes
                    };
                    
                    var result = await LessonsService.UpdateLessonAsync(LessonId, updateRequest);
                    if (result != null)
                    {
                        Snackbar.Add("Lektionen uppdaterad!", Severity.Success);
                        MudDialog.Close(DialogResult.Ok(true));
                    }
                    else
                    {
                        Snackbar.Add("Kunde inte uppdatera lektionen", Severity.Error);
                    }
                }
            }
            else
            {
                // Create new lesson
                var lesson = await LessonsService.CreateLessonAsync(lessonRequest);
                if (lesson != null)
                {
                    Snackbar.Add("Lektion skapad!", Severity.Success);
                    MudDialog.Close(DialogResult.Ok(true));
                }
                else
                {
                    Snackbar.Add("Kunde inte skapa lektionen", Severity.Error);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fel: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancel()
    {
        MudDialog.Close();
    }

    public class DropItem
    {
        public string PatternId { get; set; } = string.Empty;
        public int SectionIndex { get; set; }
        public int ItemIndex { get; set; }
    }
