@page "/register"
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Registrera - WCS Kursskapare</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Class="pa-8">
        <MudForm @ref="form" @onsubmit:preventDefault="true">
            <MudText Typo="Typo.h4" Align="Align.Center" GutterBottom="true">
                Skapa konto
            </MudText>
            <MudText Typo="Typo.body1" Align="Align.Center" GutterBottom="true" Class="mb-6">
                Gå med i WCS Kursskapare
            </MudText>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">
                    @errorMessage
                </MudAlert>
            }

            <MudTextField @bind-Value="registerRequest.Name"
                          Label="Fullständigt namn"
                          Variant="Variant.Outlined"
                          Required="true"
                          RequiredError="Namn krävs"
                          Class="mb-4" />

            <MudTextField @bind-Value="registerRequest.Email"
                          Label="E-post"
                          Variant="Variant.Outlined"
                          Required="true"
                          RequiredError="E-post krävs"
                          Class="mb-4" />

            <MudTextField @bind-Value="registerRequest.Password"
                          Label="Lösenord"
                          Variant="Variant.Outlined"
                          InputType="InputType.Password"
                          Required="true"
                          RequiredError="Lösenord krävs"
                          Class="mb-4" />

            <MudSelect @bind-Value="registerRequest.Role"
                       Label="Roll"
                       Variant="Variant.Outlined"
                       Class="mb-6">
                <MudSelectItem Value="@("instructor")">Instruktör</MudSelectItem>
                <MudSelectItem Value="@("editor")">Redaktör</MudSelectItem>
                <MudSelectItem Value="@("reader")">Läsare</MudSelectItem>
            </MudSelect>

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       FullWidth="true"
                       Disabled="isLoading"
                       OnClick="HandleRegister">
                @if (isLoading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                    <MudText Class="ml-2">Skapar konto...</MudText>
                }
                else
                {
                    <MudText>Skapa konto</MudText>
                }
            </MudButton>
        </MudForm>

        <MudDivider Class="my-6" />

        <MudText Typo="Typo.body2" Align="Align.Center">
            Har du redan ett konto?
            <MudLink Href="/login" Color="Color.Primary">Logga in</MudLink>
        </MudText>
    </MudPaper>
</MudContainer>

@code {
    private MudForm form = null!;
    private RegisterRequest registerRequest = new();
    private string errorMessage = string.Empty;
    private bool isLoading = false;

    private async Task HandleRegister()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            var result = await AuthService.RegisterAsync(registerRequest);
            
            if (result != null)
            {
                var authStateProvider = (CustomAuthStateProvider)AuthStateProvider;
                authStateProvider.MarkUserAsAuthenticated(result.User);
                Navigation.NavigateTo("/");
            }
            else
            {
                errorMessage = "Misslyckades med att skapa konto. Försök igen.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Ett fel uppstod vid registrering. Försök igen.";
        }
        finally
        {
            isLoading = false;
        }
    }
}