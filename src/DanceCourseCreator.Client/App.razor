@using DanceCourseCreator.Client.Themes
@using DanceCourseCreator.Client.Components
@using Microsoft.AspNetCore.Components.WebAssembly.Hosting

<CascadingAuthenticationState>
    <MudThemeProvider Theme="DanceTheme.Theme" />
    <MudDialogProvider />
    <MudSnackbarProvider />
    
    <ErrorBoundaryHandler ShowDetails="@_isDevelopment">
        <Router AppAssembly="@typeof(App).Assembly">
            <Found Context="routeData">
                <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                    <NotAuthorized>
                        <RedirectToLogin />
                    </NotAuthorized>
                </AuthorizeRouteView>
                <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            </Found>
            <NotFound>
                <PageTitle>Not found</PageTitle>
                <LayoutView Layout="@typeof(MainLayout)">
                    <p role="alert">Sorry, there's nothing at this address.</p>
                </LayoutView>
            </NotFound>
        </Router>
    </ErrorBoundaryHandler>
</CascadingAuthenticationState>

@code {
    private bool _isDevelopment = false;

    [Inject]
    private IWebAssemblyHostEnvironment? HostEnvironment { get; set; }

    protected override void OnInitialized()
    {
        _isDevelopment = HostEnvironment?.IsDevelopment() ?? false;
    }
}
